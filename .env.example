# Copy this file to .env and fill in your own values.
# .env is listed in .gitignore and must never be committed (CLAUDE.md, Security basics; NFR-5).

# Flask
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string

# Neo4j (used by the app and by docker-compose.yml)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Neo4j needs a password of at least 8 characters.
NEO4J_PASSWORD=change-me-please

# Image service (FR-A2.2). "stub" needs no key and makes placeholder images.
IMAGE_PROVIDER=stub
IMAGE_API_KEY=
